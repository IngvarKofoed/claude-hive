{
  "name": "claude-hive",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gen-version": "node scripts/gen-version.mjs",
    "dev": "concurrently --names backend,frontend --prefix-colors blue,magenta \"npm run dev -w packages/backend\" \"npm run dev -w packages/frontend\"",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  }
}
